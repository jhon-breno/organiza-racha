# Configurações de Banco de Dados (Supabase + Prisma)
# DATABASE_URL: URL do Transaction Pooler do Supabase (porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: URL de conexão direta do Supabase (porta 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Configurações de Autenticação (NextAuth / Auth.js)
AUTH_SECRET="substitua-por-um-segredo-aleatorio-e-forte"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# Opcional: Google OAuth Login
# Callback URL para desenvolvimento: https://[YOUR_APP_URL]/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
